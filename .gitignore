# ==========================================
# DevOps & Local Mocking (Docker / Database)
# ==========================================
# Local volume data (Blocks massive local DB data from leaking into text tools)
.data/
postgres_data/
redis_data/
minio_data/
prometheus_data/
grafana_data/
elasticsearch_data/
nginx_logs/
backend_uploads/
backend_logs/
backups/

# Keep configuration rules but block heavy cache states
.elastic/
.jaeger/

# ==========================================
# Cloud & Local Environment Configs
# ==========================================
# Local AWS profiles, credentials, or state files
.aws/
.env
.flaskenv
.terraform/
*.tfstate
*.tfstate.backup

